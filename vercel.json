{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "arham-portfolio-tau.vercel.app" }],
      "destination": "https://www.arhampowersolutions.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/our-work/?", "destination": "/our-work/index.html" },
    { "source": "/services/?", "destination": "/services/index.html" },
    { "source": "/contact/?", "destination": "/contact/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
